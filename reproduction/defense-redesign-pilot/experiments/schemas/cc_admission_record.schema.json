{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper4.local/schemas/cc_admission_record.schema.json",
  "title": "Paper 4 confidential-compute fail-closed admission record",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "admission_id",
    "session_id",
    "generated_at",
    "arrival_record",
    "arrival_record_sha256",
    "workload_binding",
    "authentication",
    "checks",
    "hardware_attested",
    "admitted",
    "blockers",
    "claim_scope"
  ],
  "properties": {
    "schema_version": {"const": "p4-cc-admission-0.3"},
    "record_type": {"const": "admission_decision"},
    "admission_id": {"$ref": "#/$defs/identifier"},
    "session_id": {"$ref": "#/$defs/identifier"},
    "generated_at": {"type": "string", "format": "date-time"},
    "arrival_record": {"type": "string", "minLength": 1},
    "arrival_record_sha256": {"$ref": "#/$defs/sha"},
    "workload_binding": {
      "type": "object",
      "required": [
        "source_tree_sha256",
        "config_sha256",
        "environment_lock_sha256",
        "runtime_environment_sha256",
        "trusted_store_manifest_sha256",
        "trusted_store_protection_evidence_sha256",
        "workload_measurement_sha256",
        "challenge_nonce_sha256",
        "journal_public_key_sha256",
        "deployment_manifest_sha256",
        "hardware_packet_sha256",
        "collector_manifest_sha256",
        "collector_executable_sha256",
        "collector_public_key_sha256"
      ],
      "properties": {
        "source_tree_sha256": {"$ref": "#/$defs/sha"},
        "config_sha256": {"$ref": "#/$defs/sha"},
        "environment_lock_sha256": {"$ref": "#/$defs/sha"},
        "runtime_environment_sha256": {"$ref": "#/$defs/sha"},
        "trusted_store_manifest_sha256": {"$ref": "#/$defs/sha"},
        "trusted_store_protection_evidence_sha256": {"$ref": "#/$defs/sha"},
        "workload_measurement_sha256": {"$ref": "#/$defs/sha"},
        "challenge_nonce_sha256": {"$ref": "#/$defs/sha"},
        "journal_public_key_sha256": {"$ref": "#/$defs/sha"},
        "deployment_manifest_sha256": {"$ref": "#/$defs/sha"},
        "hardware_packet_sha256": {"$ref": "#/$defs/sha"},
        "collector_manifest_sha256": {"$ref": "#/$defs/sha"},
        "collector_executable_sha256": {"$ref": "#/$defs/sha"},
        "collector_public_key_sha256": {"$ref": "#/$defs/sha"}
      },
      "additionalProperties": false
    },
    "authentication": {
      "type": "object",
      "required": [
        "schema",
        "verifier",
        "public_key",
        "deployment_binding",
        "decision_sha256",
        "workload_binding_sha256",
        "evidence_index_sha256",
        "signature_algorithm",
        "signature_base64"
      ],
      "properties": {
        "schema": {"const": "p4.cc_admission_authentication.v1"},
        "verifier": {
          "type": "object",
          "required": [
            "verifier_id", "adapter_kind", "adapter_measurement_sha256"
          ],
          "properties": {
            "verifier_id": {"$ref": "#/$defs/identifier"},
            "adapter_kind": {
              "enum": ["vendor_attestation_adapter", "synthetic_fixture"]
            },
            "adapter_measurement_sha256": {"$ref": "#/$defs/sha"}
          },
          "additionalProperties": false
        },
        "public_key": {
          "type": "object",
          "required": ["path", "sha256", "bytes"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha"},
            "bytes": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "deployment_binding": {
          "type": "object",
          "required": [
            "provider", "candidate_id", "sku", "region", "zone",
            "instance_id", "boot_id_sha256", "image_reference",
            "protection_mode", "pair_id", "cuda_device_index",
            "deployment_manifest_sha256", "pair_manifest_sha256",
            "hardware_packet_sha256"
          ],
          "properties": {
            "provider": {"enum": ["azure", "gcp"]},
            "candidate_id": {"$ref": "#/$defs/identifier"},
            "sku": {"type": "string", "minLength": 3, "maxLength": 128},
            "region": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
            "zone": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,64}$"},
            "instance_id": {"type": "string", "minLength": 3, "maxLength": 256},
            "boot_id_sha256": {"$ref": "#/$defs/sha"},
            "image_reference": {"type": "string", "minLength": 8, "maxLength": 1024},
            "protection_mode": {"enum": ["cc-on", "cc-off"]},
            "pair_id": {"$ref": "#/$defs/identifier"},
            "cuda_device_index": {"type": "integer", "minimum": 0},
            "deployment_manifest_sha256": {"$ref": "#/$defs/sha"},
            "pair_manifest_sha256": {"$ref": "#/$defs/sha"},
            "hardware_packet_sha256": {"$ref": "#/$defs/sha"}
          },
          "additionalProperties": false
        },
        "decision_sha256": {"$ref": "#/$defs/sha"},
        "workload_binding_sha256": {"$ref": "#/$defs/sha"},
        "evidence_index_sha256": {"$ref": "#/$defs/sha"},
        "signature_algorithm": {"const": "Ed25519"},
        "signature_base64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "required": [
        "gpu_cc_ready",
        "protected_memory_nonzero",
        "cpu_tee_verified",
        "gpu_attestation_verified",
        "cpu_attestation_verified",
        "measured_workload_identity",
        "revocation_freshness",
        "advisory_mapping",
        "environment_lock",
        "test_suite"
      ],
      "properties": {
        "gpu_cc_ready": {"$ref": "#/$defs/check"},
        "protected_memory_nonzero": {"$ref": "#/$defs/check"},
        "cpu_tee_verified": {"$ref": "#/$defs/check"},
        "gpu_attestation_verified": {"$ref": "#/$defs/check"},
        "cpu_attestation_verified": {"$ref": "#/$defs/check"},
        "measured_workload_identity": {"$ref": "#/$defs/check"},
        "revocation_freshness": {"$ref": "#/$defs/check"},
        "advisory_mapping": {"$ref": "#/$defs/check"},
        "environment_lock": {"$ref": "#/$defs/check"},
        "test_suite": {"$ref": "#/$defs/check"}
      },
      "additionalProperties": false
    },
    "hardware_attested": {"type": "boolean"},
    "admitted": {"type": "boolean"},
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "gpu_cc_ready",
          "protected_memory_nonzero",
          "cpu_tee_verified",
          "gpu_attestation_verified",
          "cpu_attestation_verified",
          "measured_workload_identity",
          "revocation_freshness",
          "advisory_mapping",
          "environment_lock",
          "test_suite"
        ]
      }
    },
    "claim_scope": {
      "const": "Admission permits engineering workload execution only; it is not a privacy or security certificate."
    }
  },
  "allOf": [
    {
      "if": {"properties": {"admitted": {"const": true}}, "required": ["admitted"]},
      "then": {
        "properties": {
          "hardware_attested": {"const": true},
          "blockers": {"maxItems": 0}
        }
      },
      "else": {
        "properties": {
          "hardware_attested": {"const": false},
          "blockers": {"minItems": 1}
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "identifier": {"type": "string", "pattern": "^(?![a-f0-9]{64}$)[A-Za-z0-9_.:-]+$"},
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence": {
      "type": "object",
      "required": ["path", "sha256", "bytes", "role", "media_type"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha"},
        "bytes": {"type": "integer", "minimum": 1},
        "role": {
          "enum": [
            "inventory",
            "raw_attestation_report",
            "verifier_output",
            "workload_measurement",
            "journal_public_key",
            "deployment_manifest",
            "hardware_packet",
            "collector_manifest",
            "collector_executable",
            "collector_public_key",
            "revocation_snapshot",
            "advisory_mapping",
            "environment_lock",
            "runtime_environment",
            "trusted_store_manifest",
            "trusted_store_protection",
            "test_output"
          ]
        },
        "media_type": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["status", "detail", "verifier", "verified_at", "evidence"],
      "properties": {
        "status": {"enum": ["passed", "failed", "missing", "unassessed"]},
        "detail": {"type": "string", "minLength": 1},
        "verifier": {"type": "string", "minLength": 1},
        "verified_at": {"type": "string", "format": "date-time"},
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidence"}
        }
      },
      "additionalProperties": false
    }
  }
}
