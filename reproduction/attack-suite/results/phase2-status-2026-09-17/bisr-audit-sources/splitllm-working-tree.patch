diff --git a/sfl/model/noise/fdp.py b/sfl/model/noise/fdp.py
new file mode 100644
index 0000000..e4cf545
--- /dev/null
+++ b/sfl/model/noise/fdp.py
@@ -0,0 +1,23 @@
+"""REPAIR (koula B1 fidelity run): this file is missing from the published
+SplitLLM repository (https://github.com/StupidTrees/SplitLLM @ c376590) —
+`sfl/model/llm/split_model.py` imports `GaussianPerturber` from
+`sfl.model.noise.fdp`, so the published tree cannot be imported at all.
+Reconstructed from the Perturber interface (sfl/model/noise/base.py) and the
+paper's smashed-data Gaussian perturbation description (CCS'24 paper SS2.3,
+Eq. 5 family). It is only exercised when noise_mode == 'gaussian'; the B1
+reference run uses noise_mode='none', so this class is never invoked — the
+repair exists solely to make the import graph loadable.
+"""
+
+import torch
+
+from sfl.model.noise.base import Perturber
+
+
+class GaussianPerturber(Perturber):
+
+    def forward(self, hidden_states):
+        if self.scale == 0:
+            return hidden_states
+        noise = torch.randn_like(hidden_states) * self.scale
+        return hidden_states + noise
