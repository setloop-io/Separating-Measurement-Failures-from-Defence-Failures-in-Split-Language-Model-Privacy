{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/privacy-constrained-remote/r1_attack_spec.schema.json",
  "title": "R1 attack specification document",
  "type": "object",
  "required": ["schema_version", "status", "specification"],
  "properties": {
    "schema_version": {"const": "r1-attack-spec-1.0"},
    "status": {"enum": ["draft", "frozen"]},
    "specification": {
      "type": "object",
      "required": [
        "ridge_lambda",
        "positive_doses",
        "positive_floor_correlation",
        "positive_floor_accuracy",
        "null_band",
        "privacy_limit_correlation",
        "privacy_limit_accuracy"
      ],
      "properties": {
        "ridge_lambda": {"type": "number", "exclusiveMinimum": 0},
        "positive_doses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "positive_floor_correlation": {"type": "number", "exclusiveMinimum": 0},
        "positive_floor_accuracy": {"type": "number", "exclusiveMinimum": 0},
        "null_band": {"type": "number", "exclusiveMinimum": 0},
        "privacy_limit_correlation": {"type": "number", "exclusiveMinimum": 0},
        "privacy_limit_accuracy": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "origin": {"type": "string"},
    "note": {"type": "string"},
    "reviewed_by": {"type": "string"},
    "reviewed_at_utc": {"type": "string"},
    "approval_reference": {"type": "string"}
  },
  "additionalProperties": false
}
