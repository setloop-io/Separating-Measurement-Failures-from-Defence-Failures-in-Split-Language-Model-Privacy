{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/privacy-constrained-remote/r1_scientific_admission.schema.json",
  "title": "R1 scientific stage admission",
  "type": "object",
  "required": [
    "schema_version",
    "created_at_utc",
    "study_id",
    "stage",
    "bundle_sha256",
    "run_count",
    "matrix_declared_device",
    "execution_device",
    "protocol",
    "protocol_sha256",
    "protocol_status_declared",
    "attack_spec_document",
    "attack_spec_sha256",
    "attack_spec_status",
    "attack_spec_source",
    "budget",
    "budget_sha256",
    "environment",
    "environment_sha256",
    "environment_review",
    "environment_review_sha256",
    "limits",
    "scientific_evidence",
    "scope",
    "note"
  ],
  "properties": {
    "schema_version": {"const": "r1-scientific-admission-1.0"},
    "created_at_utc": {"type": "string", "minLength": 1},
    "study_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["calibration", "exploratory"]},
    "bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "run_count": {"type": "integer", "minimum": 1},
    "matrix_declared_device": {"enum": ["cpu", "cuda"]},
    "execution_device": {"enum": ["cpu", "cuda"]},
    "protocol": {"type": "string", "minLength": 1},
    "protocol_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "protocol_status_declared": {"type": ["string", "null"]},
    "attack_spec_document": {"type": "object"},
    "attack_spec_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "attack_spec_status": {"enum": ["draft", "frozen"]},
    "attack_spec_source": {"type": ["object", "null"]},
    "budget": {"type": "object"},
    "budget_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "environment": {"type": "object"},
    "environment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "environment_review": {"type": "object"},
    "environment_review_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "limits": {
      "type": "object",
      "required": ["wall_clock_seconds", "output_bytes"],
      "properties": {
        "wall_clock_seconds": {"type": "integer", "exclusiveMinimum": 0},
        "output_bytes": {"type": "integer", "exclusiveMinimum": 0}
      }
    },
    "scientific_evidence": {"const": true},
    "scope": {"type": "string", "minLength": 1},
    "note": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
